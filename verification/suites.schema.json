{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Six separately reported benchmark groups",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "integration_status",
    "default_suite",
    "aggregation",
    "legacy_baseline",
    "suites"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "benchmark-repository-types-2",
        "benchmark-reporting-groups-3"
      ]
    },
    "benchmark_id": {
      "const": "cockpit-benchmark"
    },
    "integration_status": {
      "enum": [
        "local_expansion",
        "published"
      ]
    },
    "default_suite": {
      "const": "all"
    },
    "aggregation": {
      "const": "separate_repository_type_scores_no_raw_sum"
    },
    "legacy_baseline": {
      "$ref": "#/$defs/binding"
    },
    "suites": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "technology",
          "status",
          "contract",
          "manifest",
          "canonical_scores",
          "repository_count",
          "leaf_count",
          "max_score",
          "score",
          "failed_leaves",
          "published_repositories"
        ],
        "properties": {
          "id": {
            "enum": [
              "app",
              "fw",
              "new-energy-matlab",
              "architecture-center",
              "ai-center",
              "intelligent-driving-center"
            ]
          },
          "name": {
            "enum": [
              "APP",
              "FW",
              "New Energy MATLAB",
              "架构中心",
              "人工智能中心",
              "智能驾驶中心"
            ]
          },
          "technology": {
            "enum": [
              "Android",
              "MATLAB / Simulink",
              "Mixed"
            ]
          },
          "status": {
            "enum": [
              "verified_local",
              "published"
            ]
          },
          "contract": {
            "$ref": "#/$defs/binding"
          },
          "manifest": {
            "$ref": "#/$defs/binding"
          },
          "canonical_scores": {
            "$ref": "#/$defs/binding"
          },
          "repository_count": {
            "type": "integer",
            "minimum": 0
          },
          "leaf_count": {
            "type": "integer",
            "minimum": 0
          },
          "max_score": {
            "type": "integer",
            "minimum": 0
          },
          "failed_leaves": {
            "type": "integer",
            "minimum": 0
          },
          "published_repositories": {
            "type": "integer",
            "minimum": 0
          },
          "score": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "cohorts": {
            "$ref": "#/$defs/binding"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "benchmark-reporting-groups-3"
          }
        }
      },
      "then": {
        "properties": {
          "suites": {
            "minItems": 6,
            "maxItems": 6
          }
        }
      },
      "else": {
        "properties": {
          "suites": {
            "minItems": 3,
            "maxItems": 3
          }
        }
      }
    }
  ]
}
